<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- Code-only WPF: Linux builds must not run the Windows XAML/BAML compiler. -->
    <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FormulaNavigator.AddIn</AssemblyName>
    <Version>1.0.4</Version>
    <RootNamespace>FormulaNavigator.AddIn</RootNamespace>
    <ExcelAddInName>Formula Navigator</ExcelAddInName>
    <ExcelAddInFileName>FormulaNavigator</ExcelAddInFileName>
    <ExcelDnaCreate32BitAddIn>false</ExcelDnaCreate32BitAddIn>
    <ExcelDnaCreate64BitAddIn>true</ExcelDnaCreate64BitAddIn>
    <ExcelDnaPack64BitXllName>FormulaNavigator64</ExcelDnaPack64BitXllName>
    <ExcelAddInInclude>FormulaNavigator.Core.dll</ExcelAddInInclude>
    <ExcelAddInExplicitExports>true</ExcelAddInExplicitExports>
    <RunExcelDnaSetDebuggerOptions>false</RunExcelDnaSetDebuggerOptions>
    <RunExcelDnaSetDebuggerOptionsOutsideVisualStudio>false</RunExcelDnaSetDebuggerOptionsOutsideVisualStudio>
    <RunExcelDnaPack>true</RunExcelDnaPack>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FormulaNavigator.Core/FormulaNavigator.Core.csproj" />
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
</Project>
